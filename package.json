{
  "name": "docxmd",
  "displayName": "DOCXMD — Markdown editor & DOCX converter",
  "description": "Edit Markdown with a live neumorphic preview, LaTeX math, callout blocks, highlights and colour boxes; clean up scientific notation; export to Word (.docx) with headers, footers and page numbers, and import Word back to Markdown — inside VS Code. Companion to the DOCXMD PWA.",
  "version": "0.4.0",
  "publisher": "docxmd",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "docx",
    "word",
    "preview",
    "converter",
    "latex",
    "katex",
    "import",
    "highlight",
    "scientific notation",
    "front matter"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/bioluch/docxmd-vscode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bioluch/docxmd-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/bioluch/docxmd-vscode/issues"
  },
  "activationEvents": [],
  "main": "./extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "configuration": {
      "title": "DOCXMD",
      "properties": {
        "docxmd.deeplApiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Your personal DeepL API key, used to translate documents into the interface languages (EN · UK · ES · ZH). Stored locally in your VS Code settings and sent only to DeepL. Get a free key at https://www.deepl.com/pro-api."
        },
        "docxmd.pastedImages": {
          "type": "string",
          "enum": [
            "folder",
            "embed"
          ],
          "default": "folder",
          "enumDescriptions": [
            "Save pasted / dropped images to an images/ folder next to the Markdown file and insert a relative link",
            "Embed pasted / dropped images in the text as base64 data-URIs"
          ],
          "markdownDescription": "Where pasted or dropped images go. `folder` writes `images/image-001.png` next to the `.md` and inserts `![…](images/image-001.png)`; untitled documents always embed."
        },
        "docxmd.notationDictionary": {
          "type": "string",
          "default": "",
          "markdownDescription": "Dictionary for **DOCXMD: Clean up scientific notation**, one entry per line: `TCore = T_{Core}`, `R2 = R^{2}`, or just `CH4` (digits become subscripts). Empty = the built-in medical list (SpO2, CO2, O2, H2O, HbA1c, PaO2, PaCO2, SaO2, EtCO2, TCore, TPeriphery, TMean, TStd, R2).",
          "editPresentation": "multilineText"
        }
      }
    },
    "customEditors": [
      {
        "viewType": "docxmd.editor",
        "displayName": "%editor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "docxmd.openWith",
        "title": "%cmd.openWith%",
        "category": "DOCXMD"
      },
      {
        "command": "docxmd.exportDocx",
        "title": "%cmd.exportDocx%",
        "category": "DOCXMD"
      },
      {
        "command": "docxmd.exportHtml",
        "title": "%cmd.exportHtml%",
        "category": "DOCXMD"
      },
      {
        "command": "docxmd.importDocx",
        "title": "%cmd.importDocx%",
        "category": "DOCXMD"
      },
      {
        "command": "docxmd.setDeeplKey",
        "title": "%cmd.setDeeplKey%",
        "category": "DOCXMD"
      },
      {
        "command": "docxmd.cleanNotation",
        "title": "%cmd.cleanNotation%",
        "category": "DOCXMD"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "docxmd.exportDocx",
          "when": "activeCustomEditorId == docxmd.editor",
          "group": "navigation"
        },
        {
          "command": "docxmd.exportHtml",
          "when": "activeCustomEditorId == docxmd.editor",
          "group": "1_export"
        }
      ],
      "explorer/context": [
        {
          "command": "docxmd.openWith",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation"
        },
        {
          "command": "docxmd.importDocx",
          "when": "resourceExtname == .docx",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "docxmd.exportDocx",
          "when": "activeCustomEditorId == docxmd.editor"
        },
        {
          "command": "docxmd.exportHtml",
          "when": "activeCustomEditorId == docxmd.editor"
        }
      ]
    }
  }
}
